# --- Anthropic ---
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# --- Supabase ---
# supabase.com -> tu proyecto -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API -> service_role (SECRETO, solo server-side)
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Id del trip sembrado en 0004_seed.sql
NEXT_PUBLIC_TRIP_ID=11111111-1111-1111-1111-111111111111
# Los dos mails que pueden entrar. El primero es "morena", el segundo "novio".
# Tienen que coincidir con los de supabase/migrations/0003_rls.sql
NEXT_PUBLIC_ALLOWED_EMAILS=mail-morena@ejemplo.com,mail-novio@ejemplo.com
